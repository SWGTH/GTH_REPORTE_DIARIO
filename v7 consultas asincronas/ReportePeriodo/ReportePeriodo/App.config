<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <appSettings>
    <add key="fdbConnection" value="Server=localhost;User=$user;Password=$pwd;Charser=NONE;Database=C:\MOVGANADO\Tracker21.fdb" />
    <add key="oleDbConnection" value="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=C:\MOVGANADO\movsio.mdb;JET OLEDB:DATABASE PASSWORD = $pwd" />
    <add key="sqlConnection" value="data source = localhost\SIO; initial catalog = DBCONSUMO; user id = $usr; password = $pas" />
    <add key="proceso" value="false" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
